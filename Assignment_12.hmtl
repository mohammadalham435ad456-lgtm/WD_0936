
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Student Marks Table</title>
    <style>
        table {
            border-collapse: collapse;
            width: 60%;
        }
        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }
        thead {
            background-color: lightblue;
        }
        tfoot {
            background-color: lightgray;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h1>Student Marks</h1>

    <table>
        <caption>Student Examination Result</caption>

        <thead>
            <tr>
                <th>Roll No.</th>
                <th>Name</th>
                <th>Marks</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>101</td>
                <td>Rahul</td>
                <td>85</td>
            </tr>
            <tr>
                <td>102</td>
                <td>Aman</td>
                <td>90</td>
            </tr>
            <tr>
                <td>103</td>
                <td>Priya</td>
                <td>80</td>
            </tr>
        </tbody>

        <tfoot>
            <tr>
                <td colspan="2">Total Marks</td>
                <td>255</td>
            </tr>
        </tfoot>
    </table>

</body>
</html>